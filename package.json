{
  "name": "golazo",
  "version": "0.1.0",
  "description": "Agent payable World Cup 2026 data API, gated with x402 micropayments on Injective",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --loader ts-node/esm src/server.ts",
