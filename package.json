    "ingest:refresh": "node --loader ts-node/esm scripts/ingest.ts --refresh"
  },
  "dependencies": {
    "@injectivelabs/x402": "^0.1.0-rc.1",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}